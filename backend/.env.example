# ── Required ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
ADMIN_EMAIL=admin@sananeke
ADMIN_PASSWORD=replace_with_a_unique_password

# ── CORS — set to your Vercel frontend URL ───────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Optional ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
